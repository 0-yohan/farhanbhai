# Plasmic (https://studio.plasmic.app). Copy to .env and fill in.
# Project ID: the id in your Plasmic project's Studio URL.
VITE_PLASMIC_PROJECT_ID=
# Public API token: Studio -> Code toolbar button. Public by design (read-only,
# published content); never use a Plasmic secret/CMS token here.
VITE_PLASMIC_PUBLIC_TOKEN=
# true = load unpublished drafts (local/staging only). Leave false in production.
VITE_PLASMIC_PREVIEW=false
